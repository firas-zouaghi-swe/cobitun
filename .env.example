# ==================== APPLICATION ====================
# Copy this file to .env and replace placeholder values with your own.
# Never commit .env to version control.
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
PORT=3000

# ==================== DATABASE ====================
DATABASE_URL="file:./dev.db"

# ==================== AUTHENTICATION ====================
# JWT Secret (generate with: openssl rand -hex 32)
JWT_SECRET=your-jwt-secret-key
JWT_REFRESH_SECRET=your-jwt-refresh-secret-key
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ==================== ENCRYPTION ====================
# Field-level encryption key for PII (generate with: openssl rand -hex 32)
ENCRYPTION_KEY=your-encryption-key
# Optional: Custom salt for key derivation (if ENCRYPTION_KEY is a passphrase)
# ENCRYPTION_SALT=cobitun-encryption-salt

# ==================== CSRF ====================
CSRF_SECRET=your-csrf-secret-key

# ==================== EMAIL / SMTP ====================
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user@example.com
SMTP_PASS=your-smtp-password
EMAIL_FROM=your-email@example.com
EMAIL_DEFAULT_FROM=your-email@example.com
EMAIL_DELIVERY_MODE=smtp  # Options: smtp, console, file

# ==================== MFA (Email OTP) ====================
MFA_ENABLED=true
MFA_METHOD=email_otp
MFA_OTP_EXPIRY_MINUTES=10
MFA_REQUIRE_FOR_ADMINS=true

# ==================== FILE STORAGE ====================
# Local storage path (for development)
UPLOAD_DIR=./uploads
# S3-compatible storage (for production)
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_REGION=us-east-1
# S3_BUCKET=cobitun-uploads
# S3_ACCESS_KEY=your-s3-access-key
# S3_SECRET_KEY=your-s3-secret-key

# ==================== IODA (Internet Outage Detection) ====================
IODA_API_KEY=your-ioda-api-key
IODA_API_BASE_URL=https://api.ioda.inetintel.cc.gatech.edu

# ==================== REDIS (optional, for rate limiting & idempotency)
# REDIS_URL=redis://localhost:6379

# ==================== LOGGING ====================
LOG_LEVEL=info
# LOG_FORMAT=json  # Use json for production

# ==================== CORS ====================
# Comma-separated list of allowed origins
# CORS_ALLOWED_ORIGINS=http://localhost:3000,https://your-production-domain.com

# ==================== RATE LIMITING ====================
# Rate limit window in seconds
RATE_LIMIT_WINDOW=60
# Max requests per window
RATE_LIMIT_MAX=100

# ==================== SESSION ====================
SESSION_MAX_AGE=86400
SESSION_IDLE_TIMEOUT=1800

# ==================== NOTIFICATIONS ====================
# Push notification settings (if applicable)
# PUSH_NOTIFICATION_KEY=your-push-notification-key

# ==================== MONITORING ====================
# Sentry DSN (optional)
# NEXT_PUBLIC_SENTRY_DSN=your-sentry-dsn
