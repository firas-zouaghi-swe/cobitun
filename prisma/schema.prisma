generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================================
// SECTION 1: SYSTEM & AUDIT INFRASTRUCTURE
// ============================================================================

model SystemSetting {
  id           Int       @id @default(autoincrement())
  settingKey   String    @map("setting_key")
  settingValue String    @map("setting_value")
  valueType    String    @map("value_type")
  isEditable   Int       @default(1) @map("is_editable")
  category     String
  description  String?
  validFrom    DateTime  @default(now()) @map("valid_from")
  validTo      DateTime? @map("valid_to")
  isCurrent    Int       @default(1) @map("is_current")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @default(now()) @map("updated_at")
  updatedBy    Int?      @map("updated_by")
  version      Int       @default(1)

  @@unique([settingKey, validFrom])
  @@map("system_settings")
}

model SequenceRegistry {
  sequenceName String   @id @map("sequence_name")
  currentValue Int      @default(0) @map("current_value")
  prefix       String
  paddingWidth Int      @default(6) @map("padding_width")
  yearReset    Int      @default(1) @map("year_reset")
  lastYear     Int?     @map("last_year")
  description  String?
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("sequence_registry")
}

model AuditLog {
  id             Int      @id @default(autoincrement())
  entityType     String   @map("entity_type")
  entityId       Int      @map("entity_id")
  entityVersion  Int      @default(1) @map("entity_version")
  actorId        Int?     @map("actor_id")
  actorType      String   @default("USER") @map("actor_type")
  action         String
  actionCategory String   @map("action_category")
  oldValuesJson  String?  @map("old_values_json")
  newValuesJson  String?  @map("new_values_json")
  metadataJson   String?  @map("metadata_json")
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  requestPath    String?  @map("request_path")
  correlationId  String?  @map("correlation_id")
  sessionId      String?  @map("session_id")
  previousHash   String?  @map("previous_hash")
  rowHash        String?  @map("row_hash")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([createdAt], map: "idx_audit_time")
  @@index([entityType, entityId], map: "idx_audit_entity")
  @@index([actorId], map: "idx_audit_actor")
  @@index([actorId, createdAt], map: "idx_audit_actor_time")
  @@index([actionCategory], map: "idx_audit_action")
  @@index([correlationId], map: "idx_audit_correlation")
  @@map("audit_logs")
}

