model Notification {
  id                 Int       @id @default(autoincrement())
  recipientId        Int       @map("recipient_id")
  notificationType   String    @map("notification_type")
  title              String
  titleAr            String?   @map("title_ar")
  message            String
  messageAr          String?   @map("message_ar")
  isRead             Int       @default(0) @map("is_read")
  readAt             DateTime? @map("read_at")
  deliveryMethod     String    @default("IN_APP") @map("delivery_method")
  emailSent          Int       @default(0) @map("email_sent")
  emailSentAt        DateTime? @map("email_sent_at")
  smsSent            Int       @default(0) @map("sms_sent")
  smsSentAt          DateTime? @map("sms_sent_at")
  parametricPolicyId Int?      @map("parametric_policy_id")
  cyberPolicyId      Int?      @map("cyber_policy_id")
  parametricClaimId  Int?      @map("parametric_claim_id")
  cyberClaimId       Int?      @map("cyber_claim_id")
  deletedAt          DateTime? @map("deleted_at")
  deletedBy          Int?      @map("deleted_by")
  isDeleted          Int       @default(0) @map("is_deleted")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @default(now()) @map("updated_at")

  recipient        User              @relation("NotificationRecipient", fields: [recipientId], references: [id])
  parametricPolicy ParametricPolicy? @relation(fields: [parametricPolicyId], references: [id])
  cyberPolicy      CyberPolicy?      @relation(fields: [cyberPolicyId], references: [id])
  parametricClaim  ParametricClaim?  @relation(fields: [parametricClaimId], references: [id])
  cyberClaim       CyberClaim?       @relation(fields: [cyberClaimId], references: [id])
  deletedByUser    User?             @relation("NotificationDeletedBy", fields: [deletedBy], references: [id])

  @@index([recipientId, isRead], map: "idx_notif_recipient")
  @@index([notificationType], map: "idx_notif_type")
  @@index([parametricPolicyId], map: "idx_notif_param_policy")
  @@index([cyberPolicyId], map: "idx_notif_cyber_policy")
  @@index([parametricClaimId], map: "idx_notif_param_claim")
  @@index([cyberClaimId], map: "idx_notif_cyber_claim")
  @@index([deletedBy], map: "idx_notif_deleted_by")
  @@map("notifications")
}

// ============================================================================
// SECTION X: MISSING JOURNEY IMPLEMENTATIONS (Password Reset, Claims, Policies, Audit)
// ============================================================================

// =================== PASSWORD RESET & EMAIL VERIFICATION ===================
// =================== USER SESSIONS ===================

model UserSession {
  id                    Int       @id @default(autoincrement())
  userId                Int       @map("user_id")
  sessionId             String    @unique @map("session_id")
  ipAddress             String?   @map("ip_address")
  userAgent             String?   @map("user_agent")
  createdAt             DateTime  @default(now()) @map("created_at")
  lastActiveAt          DateTime? @map("last_active_at")
  revokedAt             DateTime? @map("revoked_at")
  expiresAt             DateTime? @map("expires_at")
  refreshTokenHash      String?   @map("refresh_token_hash")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_user_session_user")
  @@map("user_sessions")
}

// =================== PASSWORD RESET & EMAIL VERIFICATION ===================
model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt], map: "idx_pwd_reset_expiry")
  @@index([userId], map: "idx_pwd_reset_user")
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id         Int       @id @default(autoincrement())
  userId     Int       @map("user_id")
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  verifiedAt DateTime? @map("verified_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt], map: "idx_email_verify_expiry")
  @@index([userId], map: "idx_email_verify_user")
  @@map("email_verification_tokens")
}

// =================== IDEMPOTENCY & FINANCIAL SAFETY ===================

model IdempotencyKey {
  id             Int       @id @default(autoincrement())
  key            String    @unique
  endpoint       String?
  path           String?
  method         String?
  userId         Int?      @map("user_id")
  payloadHash    String?   @map("payload_hash")
  response       String?   // JSON (legacy)
  responseStatus Int?      @map("response_status")
  responseBody   String?   @map("response_body") // JSON
  usedAt         DateTime? @map("used_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  expiresAt      DateTime  @map("expires_at")

  @@index([expiresAt], map: "idx_idempotency_expiry")
  @@index([key], map: "idx_idempotency_key")
  @@index([userId], map: "idx_idempotency_user")
  @@map("idempotency_keys")
}

// =================== POLICY CANCELLATION & REFUNDS ===================

model PolicyCancellation {
  id                      Int       @id @default(autoincrement())
  parametricPolicyId      Int       @map("parametric_policy_id")
  customerId              Int       @map("customer_id")
  cancellationReason      String    @map("cancellation_reason")
  cancellationCategory    String    @map("cancellation_category") // 'CUSTOMER_REQUEST', 'NON_PAYMENT', 'FRAUD', 'ADMIN_CANCELLATION'
  refundAmount            Decimal   @map("refund_amount")
  refundStatus            String    @default("PENDING") @map("refund_status") // 'PENDING', 'PROCESSED', 'FAILED'
  refundProcessedAt       DateTime? @map("refund_processed_at")
  effectiveDate           DateTime  @map("effective_date")
  cancellationInitiatedBy Int       @map("cancellation_initiated_by")
  refundProcessedBy       Int?      @map("refund_processed_by")
  remarks                 String?
  deletedAt               DateTime? @map("deleted_at")
  deletedBy               Int?      @map("deleted_by")
  isDeleted               Int       @default(0) @map("is_deleted")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @default(now()) @map("updated_at")
  version                 Int       @default(1)

  parametricPolicy ParametricPolicy @relation(fields: [parametricPolicyId], references: [id])
  customer         Customer         @relation(fields: [customerId], references: [id])
  initiatedByUser  User             @relation("CancellationInitiatedBy", fields: [cancellationInitiatedBy], references: [id])
  processedByUser  User?            @relation("CancellationProcessedBy", fields: [refundProcessedBy], references: [id])
  deletedByUser    User?            @relation("CancellationDeletedBy", fields: [deletedBy], references: [id])

  @@index([parametricPolicyId], map: "idx_cancellation_policy")
  @@index([customerId], map: "idx_cancellation_customer")
  @@index([refundStatus], map: "idx_cancellation_refund_status")
  @@index([createdAt], map: "idx_cancellation_date")
  @@map("policy_cancellations")
}

// =================== CLAIM APPEAL WORKFLOW ===================

model ClaimAppeal {
  id                    Int       @id @default(autoincrement())
  paramClaimId          Int?      @map("param_claim_id")
  workflowClaimId       Int?      @map("workflow_claim_id")
  customerId            Int       @map("customer_id")
  appealReason          String    @map("appeal_reason")
  appealJustification   String?   @map("appeal_justification")
  supportingDocumentUrl String?   @map("supporting_document_url")
  appealStatus          String    @default("SUBMITTED") @map("appeal_status") // 'SUBMITTED', 'UNDER_REVIEW', 'APPROVED', 'REJECTED', 'WITHDRAWN'
  reviewedBy            Int?      @map("reviewed_by")
  reviewNotes           String?   @map("review_notes")
  reviewedAt            DateTime? @map("reviewed_at")
  appealDecision        String?   @map("appeal_decision") // 'APPROVED', 'REJECTED', 'PARTIALLY_APPROVED'
  appealDecisionAmount  Decimal?  @map("appeal_decision_amount")
  appealWithdrawnAt     DateTime? @map("appeal_withdrawn_at")
  appealWithdrawnBy     Int?      @map("appeal_withdrawn_by")
  deletedAt             DateTime? @map("deleted_at")
  deletedBy             Int?      @map("deleted_by")
  isDeleted             Int       @default(0) @map("is_deleted")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @default(now()) @map("updated_at")
  version               Int       @default(1)

  paramClaim      ParametricClaim? @relation(fields: [paramClaimId], references: [id])
  workflowClaim   WorkflowClaim?   @relation(fields: [workflowClaimId], references: [id])
  customer        Customer         @relation(fields: [customerId], references: [id])
  reviewedByUser  User?            @relation("AppealReviewedBy", fields: [reviewedBy], references: [id])
  withdrawnByUser User?            @relation("AppealWithdrawnBy", fields: [appealWithdrawnBy], references: [id])
  deletedByUser   User?            @relation("AppealDeletedBy", fields: [deletedBy], references: [id])

  @@index([paramClaimId], map: "idx_appeal_param_claim")
  @@index([workflowClaimId], map: "idx_appeal_workflow_claim")
  @@index([customerId], map: "idx_appeal_customer")
  @@index([appealStatus], map: "idx_appeal_status")
  @@index([createdAt], map: "idx_appeal_date")
  @@map("claim_appeals")
}

// =================== CLAIM REJECTION TRACKING ===================

model ClaimRejection {
  id                 Int       @id @default(autoincrement())
  paramClaimId       Int?      @map("param_claim_id")
  workflowClaimId    Int?      @map("workflow_claim_id")
  customerId         Int       @map("customer_id")
  rejectionReason    String    @map("rejection_reason")
  rejectionCategory  String    @map("rejection_category") // 'FRAUD', 'INSUFFICIENT_EVIDENCE', 'NOT_COVERED', 'POLICY_LIMIT_EXCEEDED', 'EXCLUSION_APPLIED'
  rejectedBy         Int       @map("rejected_by")
  rejectionNotes     String?   @map("rejection_notes")
  rejectedAt         DateTime  @map("rejected_at")
  appealDeadlineDate DateTime  @map("appeal_deadline_date")
  deletedAt          DateTime? @map("deleted_at")
  deletedBy          Int?      @map("deleted_by")
  isDeleted          Int       @default(0) @map("is_deleted")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @default(now()) @map("updated_at")
  version            Int       @default(1)

  paramClaim     ParametricClaim? @relation(fields: [paramClaimId], references: [id])
  workflowClaim  WorkflowClaim?   @relation(fields: [workflowClaimId], references: [id])
  customer       Customer         @relation(fields: [customerId], references: [id])
  rejectedByUser User             @relation(fields: [rejectedBy], references: [id])
  deletedByUser  User?            @relation("RejectionDeletedBy", fields: [deletedBy], references: [id])

  @@index([paramClaimId], map: "idx_rejection_param_claim")
  @@index([workflowClaimId], map: "idx_rejection_workflow_claim")
  @@index([customerId], map: "idx_rejection_customer")
  @@index([rejectionCategory], map: "idx_rejection_category")
  @@index([rejectedAt], map: "idx_rejection_date")
  @@map("claim_rejections")
}

// =================== UNDERWRITING NOTES ===================

model UnderwritingNote {
  id                 Int       @id @default(autoincrement())
  parametricPolicyId Int?      @map("parametric_policy_id")
  workflowAppId      Int?      @map("workflow_app_id")
  cyberApplicationId Int?      @map("cyber_application_id")
  createdBy          Int       @map("created_by")
  noteText           String
  noteCategory       String    @map("note_category") // 'RISK_ASSESSMENT', 'COVERAGE_CONCERN', 'PREMIUM_ADJUSTMENT', 'FOLLOW_UP_REQUIRED', 'OTHER'
  priority           String    @default("NORMAL") @map("priority") // 'LOW', 'NORMAL', 'HIGH', 'CRITICAL'
  isInternal         Int       @default(1) @map("is_internal") // 1=internal only, 0=can share with customer
  deletedAt          DateTime? @map("deleted_at")
  deletedBy          Int?      @map("deleted_by")
  isDeleted          Int       @default(0) @map("is_deleted")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @default(now()) @map("updated_at")

  parametricPolicy ParametricPolicy?          @relation("ParametricPolicyUnderwritingNotes", fields: [parametricPolicyId], references: [id])
  workflowApp      WorkflowPolicyApplication? @relation(fields: [workflowAppId], references: [id])
  cyberApp         CyberApplication?          @relation(fields: [cyberApplicationId], references: [id])
  createdByUser    User                       @relation("UnderwritingNoteCreatedBy", fields: [createdBy], references: [id])
  deletedByUser    User?                      @relation("UnderwritingNoteDeletedBy", fields: [deletedBy], references: [id])

  @@index([parametricPolicyId], map: "idx_note_param_policy")
  @@index([workflowAppId], map: "idx_note_workflow_app")
  @@index([cyberApplicationId], map: "idx_note_cyber_app")
  @@index([createdBy], map: "idx_note_creator")
  @@index([noteCategory], map: "idx_note_category")
  @@map("underwriting_notes")
}

// =================== NOTIFICATION LOG & QUEUE ===================

model NotificationLog {
  id               Int       @id @default(autoincrement())
  recipientId      Int       @map("recipient_id")
  notificationType String    @map("notification_type") // 'PASSWORD_RESET', 'CLAIM_REJECTED', 'APPEAL_SUBMITTED', etc.
  channel          String // 'EMAIL', 'SMS', 'IN_APP'
  status           String    @default("PENDING") // 'PENDING', 'SENT', 'FAILED', 'RETRYING'
  sendAttempts     Int       @default(0) @map("send_attempts")
  lastAttemptAt    DateTime? @map("last_attempt_at")
  sentAt           DateTime? @map("sent_at")
  failureReason    String?   @map("failure_reason")
  nextRetryAt      DateTime? @map("next_retry_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @default(now()) @map("updated_at")

  recipient User @relation("NotificationLogRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, status], map: "idx_notif_log_recipient_status")
  @@index([notificationType], map: "idx_notif_log_type")
  @@index([status], map: "idx_notif_log_status")
  @@index([nextRetryAt], map: "idx_notif_log_retry")
  @@map("notification_logs")
}

// =================== ADMIN CONTACT SUBMISSIONS ===================

model ContactSubmission {
  id           Int       @id @default(autoincrement())
  name         String
  email        String
  phoneNumber  String?   @map("phone_number")
  subject      String
  message      String
  messageType  String    @map("message_type") // 'INQUIRY', 'COMPLAINT', 'FEEDBACK', 'SUPPORT_REQUEST'
  status       String    @default("OPEN") @map("status") // 'OPEN', 'IN_PROGRESS', 'RESPONDED', 'CLOSED'
  respondedBy  Int?      @map("responded_by")
  responseNote String?   @map("response_note")
  respondedAt  DateTime? @map("responded_at")
  closedAt     DateTime? @map("closed_at")
  deletedAt    DateTime? @map("deleted_at")
  deletedBy    Int?      @map("deleted_by")
  isDeleted    Int       @default(0) @map("is_deleted")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @default(now()) @map("updated_at")

  respondedByUser User? @relation("ContactSubmissionRespondedBy", fields: [respondedBy], references: [id])
  deletedByUser   User? @relation("ContactSubmissionDeletedBy", fields: [deletedBy], references: [id])

  @@index([status], map: "idx_contact_status")
  @@index([messageType], map: "idx_contact_type")
  @@index([createdAt], map: "idx_contact_date")
  @@map("contact_submissions")
}

// =================== IODA AUTO-CLAIM DRAFT SUGGESTION ===================

model IODAClaimSuggestion {
  id                     Int       @id @default(autoincrement())
  iodalertId             String?   @unique @map("ioda_alert_id")
  parametricPolicyId     Int       @map("parametric_policy_id")
  customerId             Int       @map("customer_id")
  outageDescription      String    @map("outage_description")
  affectedProviders      String    @map("affected_providers") // JSON array
  detectionTimestamp     DateTime  @map("detection_timestamp")
  impactLevel            String    @map("impact_level") // 'LOW', 'MEDIUM', 'HIGH', 'CRITICAL'
  estAffectedUsers       Int?      @map("est_affected_users")
  estDowntimeMins        Int?      @map("est_downtime_mins")
  suggestedClaimAmount   Decimal?  @map("suggested_claim_amount")
  draftClaimStatus       String    @default("DRAFT") @map("draft_claim_status") // 'DRAFT', 'CLAIMED', 'IGNORED', 'FALSE_POSITIVE'
  claimedAt              DateTime? @map("claimed_at")
  claimedBy              Int?      @map("claimed_by")
  ignoredAt              DateTime? @map("ignored_at")
  ignoredBy              Int?      @map("ignored_by")
  flaggedAsFalsePositive Int       @default(0) @map("flagged_as_false_positive")
  falsePositiveBy        Int?      @map("false_positive_by")
  deletedAt              DateTime? @map("deleted_at")
  deletedBy              Int?      @map("deleted_by")
  isDeleted              Int       @default(0) @map("is_deleted")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @default(now()) @map("updated_at")

  parametricPolicy    ParametricPolicy @relation(fields: [parametricPolicyId], references: [id])
  customer            Customer         @relation(fields: [customerId], references: [id])
  claimedByUser       User?            @relation("IODAClaimClaimedBy", fields: [claimedBy], references: [id])
  ignoredByUser       User?            @relation("IODAClaimIgnoredBy", fields: [ignoredBy], references: [id])
  falsePositiveByUser User?            @relation("IODAClaimFalsePositiveBy", fields: [falsePositiveBy], references: [id])
  deletedByUser       User?            @relation("IODAClaimDeletedBy", fields: [deletedBy], references: [id])

  @@index([parametricPolicyId], map: "idx_ioda_suggestion_policy")
  @@index([customerId], map: "idx_ioda_suggestion_customer")
  @@index([draftClaimStatus], map: "idx_ioda_suggestion_status")
  @@index([detectionTimestamp], map: "idx_ioda_suggestion_timestamp")
  @@map("ioda_claim_suggestions")
}

// ============================================================================
// LEGACY MODELS (kept for backward compatibility with existing PolicyRecords)
// ============================================================================

model Policy {
  id           String    @id @default(cuid())
  categoryId   String    @map("category_id")
  policyName   String    @map("policy_name")
  sumAssurance Int       @map("sum_assurance")
  premium      Int
  tenure       Int
  isDeleted    Int       @default(0) @map("is_deleted")
  deletedAt    DateTime? @map("deleted_at")
  deletedBy    Int?      @map("deleted_by")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  records PolicyRecord[]

  @@map("policies")
}

model PolicyRecord {
  id         String   @id @default(cuid())
  customerId String   @map("customer_id")
  policyId   String   @map("policy_id")
  status     String   @default("Pending")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  policy     Policy   @relation(fields: [policyId], references: [id])

  @@map("policy_records")
}
