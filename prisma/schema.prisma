// ============================================================================
// FRAUD DETECTION — Zero-Cost Ollama + SQLite
// ============================================================================

model FraudDetectionResult {
  id              Int       @id @default(autoincrement())
  userId          Int       @map("user_id")
  ruleScore       Float     @map("rule_score")
  ruleFlags       String    @default("[]") @map("rule_flags") // JSON array
  llmScore        Float     @map("llm_score")
  llmReasoning    String?   @map("llm_reasoning")
  finalScore      Float     @map("final_score")
  verdict         String    // 'LEGITIMATE', 'REVIEW', 'FAKE'
  modelUsed       String    @map("model_used")
  latencyMs       Float     @map("latency_ms")
  ipAtCheck       String?   @map("ip_at_check")
  uaAtCheck       String?   @map("ua_at_check")
  humanLabel      String?   @map("human_label") // 'confirmed_fake', 'confirmed_legit', null
  createdAt       DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_fraud_user")
  @@index([verdict], map: "idx_fraud_verdict")
  @@index([createdAt], map: "idx_fraud_time")
  @@map("fraud_detection_results")
}

model IpReputation {
  ip            String   @id
  firstSeen     DateTime @default(now()) @map("first_seen")
  lastSeen      DateTime @default(now()) @map("last_seen")
  accountCount  Int      @default(0) @map("account_count")
  fakeCount     Int      @default(0) @map("fake_count")
  riskScore     Float    @default(0) @map("risk_score") // 0-100
  blocked       Int      @default(0) @map("is_blocked")
  notes         String?
  updatedAt     DateTime @default(now()) @map("updated_at")

  @@index([riskScore], map: "idx_ip_reputation_score")
  @@map("ip_reputation")
}

model DeviceFingerprint {
  fingerprint   String   @id
  userCount     Int      @default(0) @map("user_count")
  firstSeen     DateTime @default(now()) @map("first_seen")
  lastSeen      DateTime @default(now()) @map("last_seen")
  riskScore     Float    @default(0) @map("risk_score")
  blocked       Int      @default(0) @map("is_blocked")
  updatedAt     DateTime @default(now()) @map("updated_at")

  @@index([riskScore], map: "idx_device_risk_score")
  @@map("device_fingerprints")
}

