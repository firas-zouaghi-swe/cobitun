// ============================================================================
// SECTION 3: USER & CUSTOMER MANAGEMENT — WITH SOFT DELETE
// ============================================================================

model User {
  id                Int       @id @default(autoincrement())
  username          String    @unique
  passwordHash      String    @map("password_hash")
  passwordSalt      String    @map("password_salt")
  firstName         String    @map("first_name")
  lastName          String    @map("last_name")
  email             String    @unique
  roleId            Int       @map("role_id")
  isActive          Int       @default(1) @map("is_active")
  emailVerified     Int       @default(0) @map("email_verified")
  emailVerifiedAt   DateTime? @map("email_verified_at")
  lastLoginAt       DateTime? @map("last_login_at")
  lastLoginIp       String?   @map("last_login_ip")
  failedLoginCount  Int       @default(0) @map("failed_login_count")
  lockedUntil       DateTime? @map("locked_until")
  passwordChangedAt DateTime? @map("password_changed_at")
  passwordExpiresAt DateTime? @map("password_expires_at")
  mfaEnabled        Int       @default(0) @map("mfa_enabled")
  mfaSecret         String?   @map("mfa_secret")
  deletedAt         DateTime? @map("deleted_at")
  deletedBy         Int?      @map("deleted_by")
  deletionReason    String?   @map("deletion_reason")
  isDeleted         Int       @default(0) @map("is_deleted")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @default(now()) @map("updated_at")
  createdBy         Int?      @map("created_by")
  updatedBy         Int?      @map("updated_by")
  version           Int       @default(1)

  role                                EnumUserRole                  @relation(fields: [roleId], references: [id])
  deletedByUser                       User?                         @relation("UserSelfDeletedBy", fields: [deletedBy], references: [id])
  customer                            Customer?
  fraudResults                        FraudDetectionResult[]
  contactMessagesResponded            ContactMessage[]
  customerQuestionsAssigned           CustomerQuestion[]
  categoriesCreatedBy                 Category[]                    @relation("CategoryCreatedBy")
  categoriesUpdatedBy                 Category[]                    @relation("CategoryUpdatedBy")
  productsCreatedBy                   Product[]                     @relation("ProductCreatedBy")
  productsUpdatedBy                   Product[]                     @relation("ProductUpdatedBy")
  cloudProvidersVerifiedBy            CloudProvider[]               @relation("CloudProviderVerifiedBy")
  cloudProvidersCreatedBy             CloudProvider[]               @relation("CloudProviderCreatedBy")
  cloudProvidersUpdatedBy             CloudProvider[]               @relation("CloudProviderUpdatedBy")
  payoutConfigsCreatedBy              PayoutFunctionConfig[]        @relation("PayoutConfigCreatedBy")
